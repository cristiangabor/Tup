# Fast-deploy variant: expects the binary to already be cross-compiled on the
# host via `cross build --release --target armv7-unknown-linux-gnueabihf`.
# See deploy/scripts/cross-build.sh. No Rust toolchain runs inside this build.
FROM gcr.io/distroless/cc-debian12:nonroot
WORKDIR /app
COPY target/armv7-unknown-linux-gnueabihf/release/web-service /usr/local/bin/web-service
COPY static /app/static
EXPOSE 3001
CMD ["web-service"]
