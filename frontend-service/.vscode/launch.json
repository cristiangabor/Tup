{
  "version": "0.2.0",
  "configurations": [
    {
      // Primary: CodeLLDB (vadimcn.vscode-lldb)
      "type": "lldb",
      "request": "launch",
      "name": "Debug web-service (lldb)",
      "cargo": {
        "args": ["build", "--bin=web-service", "--package=web-service"],
        "filter": { "name": "web-service", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "debug",
        "RUST_BACKTRACE": "1",
        "PORT": "3001",
        "FARMER_API_URL": "http://backend-service:3000",
        "AUTH_SERVICE_URL": "http://auth-service:3002",
        "AUTH_PUBLIC_URL": "http://localhost:3002"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests (lldb)",
      "cargo": {
        "args": ["test", "--no-run", "--bin=web-service", "--package=web-service"],
        "filter": { "name": "web-service", "kind": "bin" }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_BACKTRACE": "1" }
    },
    {
      // Fallback: gdb via the C/C++ extension (ms-vscode.cpptools).
      // Use this if CodeLLDB can't download its platform package.
      "type": "cppdbg",
      "request": "launch",
      "name": "Debug web-service (gdb)",
      "preLaunchTask": "cargo build",
      "program": "${workspaceFolder}/target/debug/web-service",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "environment": [
        { "name": "RUST_LOG", "value": "debug" },
        { "name": "RUST_BACKTRACE", "value": "1" },
        { "name": "PORT", "value": "3001" },
        { "name": "FARMER_API_URL", "value": "http://backend-service:3000" },
        { "name": "AUTH_SERVICE_URL", "value": "http://auth-service:3002" },
        { "name": "AUTH_PUBLIC_URL", "value": "http://localhost:3002" }
      ],
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true },
        { "description": "Load Rust gdb pretty printers", "text": "source /usr/local/rustup/toolchains/*/lib/rustlib/etc/gdb_load_rust_pretty_printers.py", "ignoreFailures": true }
      ]
    },
    {
      "type": "cppdbg",
      "request": "attach",
      "name": "Attach to web-service (gdb)",
      "program": "${workspaceFolder}/target/debug/web-service",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
